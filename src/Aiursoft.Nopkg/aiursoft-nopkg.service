[Unit]
Description=Aiursoft Nopkg Web Application
After=network.target

[Service]
WorkingDirectory=/usr/share/aiursoft-nopkg
ExecStart=/usr/bin/dotnet /usr/share/aiursoft-nopkg/Aiursoft.Nopkg.dll --urls http://*:5000
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=aiursoft-nopkg
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=HOME=/var/lib/aiursoft-nopkg

[Install]
WantedBy=multi-user.target
