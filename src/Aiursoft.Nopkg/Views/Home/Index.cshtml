@model Aiursoft.Nopkg.Models.HomeViewModels.IndexViewModel
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css" />
    <link rel="stylesheet" href="~/styles/marketing.css" />
}
<vc:marketing-navbar></vc:marketing-navbar>
<div class="container py-5 text-center">
    <h1>Aiursoft Nopkg</h1>
    <p class="lead">@Localizer["Your npm registry, ready when you need it."]</p>
    <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">@Localizer["Browse packages"]</a>
    <p class="small text-muted mt-4">@Localizer["Publish your packages and cache upstream releases with optional S360 admission."]</p>
</div>

<vc:marketing-footer></vc:marketing-footer>
